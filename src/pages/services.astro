---
import Layout from '../layouts/Layout.astro';
import Marquee from '../components/ui/Marquee.astro';

const servicesTicker = [
  'Full-Stack Web Apps',
  'Offline-First Desktop Systems',
  'Mobile iOS & Android',
  'Spring Boot & Node.js Backends',
  'Custom POS & Retail Solutions',
  'Cloud Architecture & DevOps',
  'Dedicated Engineering Pods',
  'Direct Contact: hello@jiapp.online',
];

const services = [
  {
    id: 'web',
    tag: 'Web Development',
    title: 'Modern, High-Speed Web Applications & Portals',
    color: 'bg-brand-500 text-white',
    badge: 'Core Expertise',
    badgeClass: 'bg-lime text-ink',
    description:
      'We architect blazing-fast, secure, and SEO-optimized web applications, client portals, and SaaS dashboards. From responsive marketing sites to complex enterprise platforms, our code is built for high speed and seamless user experiences.',
    highlights: [
      'Next.js, Astro, React, TypeScript',
      'Ultra-fast load times (<1s LCP) and modern SEO',
      'Complex dashboard & data visualizations',
      'Seamless REST & GraphQL API integrations',
      'Full source code ownership & documented architectures',
    ],
    ctaText: 'Hire Web Developers',
  },
  {
    id: 'custom',
    tag: 'Custom Software & Desktop',
    title: 'Offline-First Desktop & Business Systems',
    color: 'bg-lime text-ink',
    badge: 'Specialty',
    badgeClass: 'bg-ink text-white',
    description:
      'Drawing on our proven experience building retail systems like BillZ POS, we craft rock-solid desktop applications and specialized business tools that operate without internet dependencies, multi-counter LAN sync, and deep hardware peripheral support.',
    highlights: [
      'Cross-platform desktop apps (Windows, macOS, Linux)',
      'Electron, SQLite, Rust, and Native integration',
      'Thermal printers, barcode scanners & cash drawer integration',
      'Zero cloud lock-in & local database sovereignty',
      'High-throughput offline transaction engines',
    ],
    ctaText: 'Build Custom Software',
  },
  {
    id: 'mobile',
    tag: 'Mobile App Engineering',
    title: 'Native & Cross-Platform Mobile Applications',
    color: 'bg-sky text-ink',
    badge: 'iOS & Android',
    badgeClass: 'bg-ink text-white',
    description:
      'Turn your product vision into responsive, intuitive mobile apps for millions of users. We design and develop native Android and cross-platform apps that feel snappy, work offline, and integrate smoothly with device sensors and payment gateways.',
    highlights: [
      'Flutter & React Native cross-platform apps',
      'Native Android (Kotlin) development',
      'Offline data caching & sync when online',
      'Play Store & App Store deployment & compliance',
      'Push notifications, analytics & payment gateway setups',
    ],
    ctaText: 'Launch Mobile App',
  },
  {
    id: 'cloud',
    tag: 'Cloud & Backend Systems',
    title: 'Scalable Microservices, APIs & DevOps',
    color: 'bg-white text-ink',
    badge: 'Enterprise Backend',
    badgeClass: 'bg-brand-500 text-white',
    description:
      'The backbone of any robust digital business is a resilient server architecture. We build high-throughput backend systems, resilient microservices, and automated CI/CD deployment pipelines tailored for enterprise reliability.',
    highlights: [
      'Spring Boot (Java/Kotlin), Node.js, Go microservices',
      'PostgreSQL, MySQL, Redis, MongoDB caching & storage',
      'Docker, Kubernetes, AWS, GCP & hybrid deployments',
      'Automated CI/CD pipelines & zero-downtime updates',
      'Rigorous security, encryption & token authentication',
    ],
    ctaText: 'Engineer Backend APIs',
  },
  {
    id: 'uiux',
    tag: 'Product & UI/UX',
    title: 'User-Centric Interface Design & Prototyping',
    color: 'bg-pop/30 text-ink',
    badge: 'Human Centered',
    badgeClass: 'bg-ink text-white',
    description:
      'Great software is both powerful and effortless to operate. We create intuitive design systems, clickable prototypes, and conversion-focused customer journeys that reduce user errors and make complex enterprise workflows feel simple.',
    highlights: [
      'Figma design systems & interactive prototypes',
      'User journey mapping & usability audits',
      'Accessibility (WCAG 2.1) compliance',
      'Design handoff with production-ready tokens',
      'Design sprints for rapid MVP validation',
    ],
    ctaText: 'Design Your Product',
  },
  {
    id: 'consulting',
    tag: 'IT Consulting',
    title: 'Architecture Audits & Tech Modernization',
    color: 'bg-sun text-ink',
    badge: 'Advisory',
    badgeClass: 'bg-ink text-white',
    description:
      'Need an expert team to evaluate your existing codebase, optimize database performance, or plan an offline-first migration? Our senior engineers conduct thorough architecture reviews and guide your engineering roadmap.',
    highlights: [
      'Legacy system refactoring & cloud migration',
      'Database query optimization & indexing',
      'Offline-first and local-first architecture strategy',
      'Security vulnerability audits & code reviews',
      'Fractional CTO & tech leadership advisory',
    ],
    ctaText: 'Request an Audit',
  },
];

const techStack = [
  {
    category: 'Frontend & Web',
    skills: ['Astro', 'Next.js', 'React', 'TypeScript', 'Tailwind CSS', 'Vue.js', 'HTML5/Canvas'],
  },
  {
    category: 'Backend & APIs',
    skills: ['Spring Boot', 'Java', 'Kotlin', 'Node.js', 'Express', 'Go', 'REST APIs', 'GraphQL'],
  },
  {
    category: 'Desktop & Native',
    skills: ['Electron', 'Tauri', 'SQLite', 'C++', 'ESC/POS Printer Protocol', 'LAN Socket Sync'],
  },
  {
    category: 'Mobile',
    skills: ['Flutter', 'React Native', 'Android Native (Kotlin)', 'iOS Swift', 'SQLite Mobile'],
  },
  {
    category: 'Cloud & Infrastructure',
    skills: ['AWS', 'Google Cloud', 'Docker', 'Kubernetes', 'PostgreSQL', 'Redis', 'GitHub Actions'],
  },
];

const processSteps = [
  {
    num: '01',
    title: 'Discovery & Blueprinting',
    desc: 'We unpack your business goals, user personas, technical constraints, and define a precise scope of work with milestone deliverables.',
  },
  {
    num: '02',
    title: 'Architecture & Design',
    desc: 'We design the database schemas, API contracts, and high-fidelity interactive Figma prototypes before writing production code.',
  },
  {
    num: '03',
    title: 'Agile Development Sprints',
    desc: 'Bi-weekly sprints with continuous demo environments. You review working software every 14 days with zero black-box surprises.',
  },
  {
    num: '04',
    title: 'QA, Stress & Security Testing',
    desc: 'Rigorous unit testing, automated end-to-end tests, edge-case validation, and security reviews ensure battle-hardened reliability.',
  },
  {
    num: '05',
    title: 'Deployment & SLA Support',
    desc: 'Seamless production rollout, training documentation, complete source code handover, and ongoing SLA maintenance agreements.',
  },
];
---

<Layout
  title="IT Services & Custom Software Development | JiApps"
  description="JiApps provides full-cycle IT services: custom web applications, offline-first desktop systems, mobile apps, Spring Boot backend engineering, and dedicated developer hiring."
>
  <main id="main" class="flex-grow">

    <!-- Header Section -->
    <section class="max-w-6xl mx-auto px-6 pt-14 md:pt-20 pb-16">
      <div class="inline-flex items-center gap-2 sticker mb-6 rotate-0">
        <span class="w-2.5 h-2.5 rounded-full bg-brand-500 animate-ping"></span>
        <span>JiApp IT & Software Engineering Services</span>
      </div>

      <h1 class="h-mega max-w-4xl mb-7">
        We engineer software that drives real businesses.
      </h1>

      <p class="text-lg md:text-2xl text-ink-light max-w-3xl leading-relaxed mb-10">
        Beyond our own products, <strong class="text-ink">JiApp operates as a full-service software development agency</strong>. We partner with ambitious startups, retail enterprises, and growing organizations to build robust web portals, desktop tools, mobile apps, and scalable backends.
      </p>

      <div class="flex flex-wrap gap-4 items-center">
        <a href="/hire-us" class="btn btn-lime text-base !py-3 !px-7">
          <span>Hire Our Team</span>
          <svg class="w-5 h-5 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
        <a href="mailto:hello@jiapp.online" class="btn bg-white text-base !py-3 !px-7">
          <svg class="w-5 h-5 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          <span>hello@jiapp.online</span>
        </a>
      </div>
    </section>

    <!-- Services Ticker -->
    <Marquee items={servicesTicker} />

    <!-- Services Grid -->
    <section class="max-w-6xl mx-auto px-6 pt-24 pb-16">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-14 gap-6">
        <div>
          <span class="text-xs uppercase font-extrabold tracking-wider text-brand-500 bg-brand-100 px-3 py-1 rounded-full border border-line">Capabilities</span>
          <h2 class="h-page mt-3">What We Build For You</h2>
        </div>
        <p class="text-ink-light max-w-md text-base leading-relaxed">
          From full enterprise overhauls to single-purpose high-efficiency tools, each project is delivered with 100% intellectual property ownership to you.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {services.map((service) => (
          <article id={service.id} class={`card p-8 md:p-10 flex flex-col justify-between scroll-mt-24 ${service.color}`}>
            <div>
              <div class="flex items-center justify-between gap-4 mb-6">
                <span class="font-mono text-xs font-bold uppercase tracking-wider opacity-80">{service.tag}</span>
                <span class={`text-[11px] font-extrabold px-3 py-1 rounded-full border border-line ${service.badgeClass}`}>
                  {service.badge}
                </span>
              </div>

              <h3 class="text-2xl md:text-3xl font-extrabold mb-4 leading-tight">
                {service.title}
              </h3>

              <p class="text-base leading-relaxed mb-6 opacity-90">
                {service.description}
              </p>

              <div class="pt-4 border-t-2 border-line/20 mb-8">
                <h4 class="text-xs font-mono font-extrabold uppercase tracking-wider mb-3 opacity-75">Key Deliverables</h4>
                <ul class="space-y-2 text-sm">
                  {service.highlights.map((item) => (
                    <li class="flex items-start gap-2.5">
                      <span class="text-lime font-extrabold shrink-0">&#10003;</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div>
              <a
                href={`/hire-us?service=${service.id}`}
                class="btn !bg-white !text-ink w-full justify-center !shadow-[3px_3px_0_var(--color-line)] hover:!bg-lime transition-colors"
              >
                <span>{service.ctaText}</span>
                <span class="ml-1">&rarr;</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Featured Client Work / Case Studies -->
    <section class="max-w-6xl mx-auto px-6 py-16">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
        <div>
          <span class="sticker !bg-lime text-ink rotate-0 mb-3">Proven Track Record</span>
          <h2 class="h-page mt-2">Featured Client Work</h2>
        </div>
        <p class="text-ink-light max-w-md text-base leading-relaxed">
          Real products and production systems built and shipped for our client partners across web and mobile.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Client 1: Devishi IPL -->
        <article class="card p-8 md:p-10 !bg-white flex flex-col justify-between hover:-translate-y-1 transition-transform">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-mono font-bold uppercase tracking-wider bg-brand-100 text-brand-700 px-3 py-1 rounded-full border border-line">
                Web Platform &bull; Corporate Infra
              </span>
              <span class="text-xs font-bold text-ink-light">Live Client</span>
            </div>

            <h3 class="text-2xl md:text-3xl font-extrabold mb-3 leading-tight">
              Devishi Projects &amp; Infrastructure
            </h3>

            <p class="text-ink-light text-base leading-relaxed mb-6">
              Engineered the corporate digital platform and interactive project portfolio for <strong>Devishi Projects Limited</strong>. The platform showcases active infrastructure developments, corporate filings, investor relations, and integrates an automated lead and inquiry management engine.
            </p>

            <div class="space-y-2 mb-6 text-sm">
              <div class="flex items-start gap-2">
                <span class="text-brand-500 font-bold">&#10003;</span>
                <span>Sub-second page speeds deployed on Cloudflare Global Edge</span>
              </div>
              <div class="flex items-start gap-2">
                <span class="text-brand-500 font-bold">&#10003;</span>
                <span>Interactive infrastructure portfolio showcase &amp; project filters</span>
              </div>
              <div class="flex items-start gap-2">
                <span class="text-brand-500 font-bold">&#10003;</span>
                <span>Automated investor relations &amp; lead capture pipeline</span>
              </div>
            </div>

            <div class="flex flex-wrap gap-2 pt-4 border-t-2 border-line/10 mb-8">
              {['Next.js', 'React', 'TypeScript', 'Tailwind CSS', 'Cloudflare Edge'].map((tag) => (
                <span class="text-xs font-mono font-semibold px-2.5 py-1 rounded-md bg-brand-50 border border-line/20 text-ink">
                  {tag}
                </span>
              ))}
            </div>
          </div>

          <div>
            <a
              href="https://www.devishipl.com/"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-lime w-full justify-center !text-sm"
            >
              <span>Visit devishipl.com</span>
              <svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            </a>
          </div>
        </article>

        <!-- Client 2: CareMate Mobile App -->
        <article class="card p-8 md:p-10 !bg-sky flex flex-col justify-between hover:-translate-y-1 transition-transform">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-mono font-bold uppercase tracking-wider bg-white text-ink px-3 py-1 rounded-full border border-line">
                Mobile App &bull; HealthTech
              </span>
              <span class="text-xs font-bold text-ink-light">iOS &amp; Android</span>
            </div>

            <h3 class="text-2xl md:text-3xl font-extrabold mb-3 leading-tight">
              CareMate Mobile App
            </h3>

            <p class="text-ink/80 text-base leading-relaxed mb-6">
              Architected and developed <strong>CareMate</strong>, a patient healthcare monitoring and caregiver coordination mobile application. Features real-time vital tracking, medication scheduling alerts, encrypted tele-consultation, and instant emergency SOS broadcast with GPS location.
            </p>

            <div class="space-y-2 mb-6 text-sm text-ink/90">
              <div class="flex items-start gap-2">
                <span class="font-extrabold text-ink">&#10003;</span>
                <span>Real-time patient vitals logging (pulse, BP, sugar, SpO2)</span>
              </div>
              <div class="flex items-start gap-2">
                <span class="font-extrabold text-ink">&#10003;</span>
                <span>Caregiver medication schedule reminders &amp; push notifications</span>
              </div>
              <div class="flex items-start gap-2">
                <span class="font-extrabold text-ink">&#10003;</span>
                <span>One-tap Emergency SOS with live location broadcasting</span>
              </div>
            </div>

            <div class="flex flex-wrap gap-2 pt-4 border-t-2 border-line/10 mb-8">
              {['Flutter', 'Kotlin', 'Firebase', 'Node.js APIs', 'WebSockets', 'Offline-First'].map((tag) => (
                <span class="text-xs font-mono font-semibold px-2.5 py-1 rounded-md bg-white border border-line/20 text-ink">
                  {tag}
                </span>
              ))}
            </div>
          </div>

          <div>
            <a
              href="/hire-us?service=mobile"
              class="btn btn-ink w-full justify-center !text-sm text-white"
            >
              <span>Build a Mobile App Like CareMate &rarr;</span>
            </a>
          </div>
        </article>
      </div>
    </section>

    <!-- Why Choose JiApp Services / Engineering Standard -->
    <section class="max-w-6xl mx-auto px-6 py-20">
      <div class="card p-8 md:p-14 !bg-ink text-white">
        <div class="max-w-3xl mb-12">
          <span class="sticker !bg-lime text-ink mb-4 rotate-1">The JiApp Engineering Guarantee</span>
          <h2 class="text-3xl md:text-5xl font-extrabold mt-4 mb-6 leading-tight">
            We are builders who run real software, not just slide decks.
          </h2>
          <p class="text-white/80 text-lg leading-relaxed">
            Most software agencies churn out templated code and disappear. Because JiApp also engineers and maintains proprietary software like BillZ POS serving real Indian merchants, our service team carries the same rigorous standards into your client project.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10">
            <div class="text-3xl font-display font-black text-lime mb-2">100%</div>
            <h3 class="font-bold text-lg mb-1">Code Ownership</h3>
            <p class="text-white/70 text-sm">All intellectual property, repositories, and credentials belong to you from day one.</p>
          </div>
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10">
            <div class="text-3xl font-display font-black text-sun mb-2">0%</div>
            <h3 class="font-bold text-lg mb-1">Bloat & Lag</h3>
            <p class="text-white/70 text-sm">We obsess over performance budgets, local execution, and snappy response times.</p>
          </div>
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10">
            <div class="text-3xl font-display font-black text-sky mb-2">&lt;24h</div>
            <h3 class="font-bold text-lg mb-1">Direct Communication</h3>
            <p class="text-white/70 text-sm">Talk directly to engineers and tech leads via Slack/WhatsApp, not layers of account managers.</p>
          </div>
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10">
            <div class="text-3xl font-display font-black text-pop mb-2">99.9%</div>
            <h3 class="font-bold text-lg mb-1">Production Reliability</h3>
            <p class="text-white/70 text-sm">Stress-tested setups designed to work in tough real-world conditions without crashing.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Tech Stack Matrix -->
    <section class="max-w-6xl mx-auto px-6 py-12">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <h2 class="h-page mb-4">Our Technology Stack</h2>
        <p class="text-ink-light text-lg">
          We select battle-tested tools designed for durability, maintainability, and extreme execution speed.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-6">
        {techStack.map((tech) => (
          <div class="card p-6 flex flex-col justify-between">
            <div>
              <h3 class="font-extrabold text-lg mb-4 pb-2 border-b-2 border-line text-brand-600">
                {tech.category}
              </h3>
              <ul class="space-y-2">
                {tech.skills.map((skill) => (
                  <li class="flex items-center gap-2 text-sm font-medium">
                    <span class="w-1.5 h-1.5 rounded-full bg-brand-500"></span>
                    <span>{skill}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Process Section -->
    <section class="max-w-6xl mx-auto px-6 py-20">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="sticker !bg-sun text-ink mb-3 -rotate-1">How We Work</span>
        <h2 class="h-page mt-2 mb-4">From Idea to Production Code</h2>
        <p class="text-ink-light text-lg">
          A predictable, transparent engineering methodology tailored to ship on time without budget surprises.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-5 gap-6">
        {processSteps.map((step) => (
          <div class="card p-6 flex flex-col justify-between !bg-white hover:-translate-y-1 transition-transform">
            <div>
              <span class="font-display font-black text-3xl text-brand-500 mb-3 block">
                {step.num}
              </span>
              <h3 class="font-extrabold text-lg mb-2 leading-snug">
                {step.title}
              </h3>
              <p class="text-ink-light text-sm leading-relaxed">
                {step.desc}
              </p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Engagement Models -->
    <section class="max-w-6xl mx-auto px-6 py-12">
      <h2 class="h-page text-center mb-14">Flexible Engagement Models</h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Model 1 -->
        <div class="card p-8 flex flex-col justify-between">
          <div>
            <span class="chip mb-4">Milestone-Based</span>
            <h3 class="text-2xl font-extrabold mb-3">Fixed Scope Project</h3>
            <p class="text-ink-light text-sm leading-relaxed mb-6">
              Best for clearly defined projects like MVPs, new web portals, mobile apps, or specific feature builds. Transparent milestone payments tied to deliverable demos.
            </p>
            <ul class="space-y-2 text-sm mb-8">
              <li class="flex items-center gap-2">✓ Fixed delivery timeline</li>
              <li class="flex items-center gap-2">✓ Defined scope & deliverables</li>
              <li class="flex items-center gap-2">✓ 30 days post-launch warranty</li>
            </ul>
          </div>
          <a href="/hire-us?model=fixed" class="btn w-full text-center">Start Fixed Scope</a>
        </div>

        <!-- Model 2 -->
        <div class="card p-8 flex flex-col justify-between !bg-lime">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="chip !bg-ink !text-white !border-ink">Most Popular</span>
              <span class="text-xs font-bold text-ink">Agile Pods</span>
            </div>
            <h3 class="text-2xl font-extrabold mb-3">Dedicated Engineers</h3>
            <p class="text-ink/80 text-sm leading-relaxed mb-6">
              Hire senior full-stack, frontend, or backend developers integrated directly into your existing team or working as an autonomous squad managed by JiApp.
            </p>
            <ul class="space-y-2 text-sm mb-8 font-medium">
              <li class="flex items-center gap-2">✓ Full-time dedicated allocation</li>
              <li class="flex items-center gap-2">✓ Daily syncs & sprint participation</li>
              <li class="flex items-center gap-2">✓ Flexible monthly billing</li>
            </ul>
          </div>
          <a href="/hire-us?model=dedicated" class="btn btn-ink w-full text-center">Hire Dedicated Pod</a>
        </div>

        <!-- Model 3 -->
        <div class="card p-8 flex flex-col justify-between">
          <div>
            <span class="chip mb-4">Long-Term SLA</span>
            <h3 class="text-2xl font-extrabold mb-3">Maintenance & Retainer</h3>
            <p class="text-ink-light text-sm leading-relaxed mb-6">
              Ensure your mission-critical applications stay updated, secure, and fast. Ongoing code maintenance, feature updates, bug fixes, and DevOps monitoring.
            </p>
            <ul class="space-y-2 text-sm mb-8">
              <li class="flex items-center gap-2">✓ Priority bug fixing & uptime SLA</li>
              <li class="flex items-center gap-2">✓ Security & dependency audits</li>
              <li class="flex items-center gap-2">✓ Guaranteed monthly dev hours</li>
            </ul>
          </div>
          <a href="/hire-us?model=retainer" class="btn w-full text-center">Inquire Retainer</a>
        </div>
      </div>
    </section>

    <!-- Bottom CTA Banner -->
    <section class="max-w-6xl mx-auto px-6 pt-16 pb-12">
      <div class="card p-10 md:p-16 text-center !bg-brand-500 text-white relative overflow-hidden">
        <span class="sticker !bg-lime text-ink mb-6 inline-block">Ready to Collaborate?</span>
