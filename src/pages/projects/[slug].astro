---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getCategoryClass, getStatusClass, CATEGORY_MAP, formatDate } from '../../lib/utils';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.data.slug || project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;
const category = CATEGORY_MAP[data.category];

// Get related projects
const allProjects = await getCollection('projects');
const related = allProjects
  .filter((p) => p.data.category === data.category && p.data.slug !== data.slug)
  .slice(0, 3);
---

<BaseLayout
  title={data.title}
  description={data.description}
  image={data.coverImage}
>
  <div class="pt-24">
    <!-- Hero -->
    <div class="relative overflow-hidden">
      <div class="absolute inset-0 ji-dot-bg opacity-30"></div>
      <div class="ji-container relative z-10 pt-12 pb-16">
        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 text-sm text-[rgb(var(--muted))] mb-8">
          <a href="/" class="hover:text-[rgb(var(--foreground))] transition-colors">Home</a>
          <span>/</span>
          <a href="/projects" class="hover:text-[rgb(var(--foreground))] transition-colors">Projects</a>
          <span>/</span>
          <span class="text-[rgb(var(--foreground))]">{data.title}</span>
        </nav>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <!-- Info -->
          <div class="animate-fade-up">
            <div class="flex flex-wrap items-center gap-3 mb-4">
              <span class={`ji-badge ${getCategoryClass(data.category)}`}>
                {category?.icon} {category?.label}
              </span>
              <span class={`ji-badge ${getStatusClass(data.status)} capitalize`}>
                {data.status}
              </span>
              {data.featured && (
                <span class="ji-badge bg-amber-500/20 text-amber-400 border border-amber-500/30">
                  ★ Featured
                </span>
              )}
            </div>

            <h1 class="ji-heading-lg mb-4">{data.title}</h1>
            <p class="text-lg text-[rgb(var(--muted))] leading-relaxed mb-6">{data.description}</p>

            <!-- Stats -->
            {data.stats && (
              <div class="flex gap-6 mb-6">
                {data.stats.users && (
                  <div>
                    <div class="ji-heading-sm ji-gradient-text">{data.stats.users}</div>
                    <div class="text-xs text-[rgb(var(--muted))]">Active Users</div>
                  </div>
                )}
                {data.stats.rating && (
                  <div>
                    <div class="ji-heading-sm ji-gradient-text">⭐ {data.stats.rating}</div>
                    <div class="text-xs text-[rgb(var(--muted))]">Rating</div>
                  </div>
                )}
                {data.stats.downloads && (
                  <div>
                    <div class="ji-heading-sm ji-gradient-text">{data.stats.downloads}</div>
                    <div class="text-xs text-[rgb(var(--muted))]">Downloads</div>
                  </div>
                )}
              </div>
            )}

            <!-- Action buttons -->
            <div class="flex flex-wrap gap-3">
              {data.liveUrl && (
                <a href={data.liveUrl} target="_blank" rel="noopener noreferrer" class="ji-btn-primary">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                  View Live
                </a>
              )}
              {data.githubUrl && (
                <a href={data.githubUrl} target="_blank" rel="noopener noreferrer" class="ji-btn-secondary">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                  </svg>
                  Source Code
                </a>
              )}
            </div>
          </div>

          <!-- Cover Image -->
          <div class="relative animate-fade-up animate-delay-200">
            <div class="relative rounded-2xl overflow-hidden aspect-video bg-gradient-to-br from-indigo-500/10 to-purple-500/10 ji-glow">
              <img
                src={data.coverImage}
                alt={data.title}
                class="w-full h-full object-cover"
                onerror="this.style.display='none'"
              />
              <div class="absolute inset-0 flex items-center justify-center text-6xl" style="display:none" id="cover-fallback">
                {category?.icon || '📦'}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Details -->
    <div class="ji-container py-16">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Main Content -->
        <div class="lg:col-span-2 space-y-10">
          {data.longDescription && (
            <div class="animate-on-scroll">
              <h2 class="ji-heading-md mb-4">About {data.title}</h2>
              <p class="text-[rgb(var(--muted))] leading-relaxed">{data.longDescription}</p>
            </div>
          )}

          {data.features && data.features.length > 0 && (
            <div class="animate-on-scroll">
              <h2 class="ji-heading-md mb-6">Key Features</h2>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                {data.features.map((feature) => (
                  <div class="flex items-start gap-3 ji-card p-4">
                    <div class="w-5 h-5 rounded-full bg-indigo-500/10 flex items-center justify-center flex-shrink-0 mt-0.5">
                      <svg class="w-3 h-3 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                      </svg>
                    </div>
                    <p class="text-sm text-[rgb(var(--muted))]">{feature}</p>
                  </div>
                ))}
              </div>
            </div>
          )}

          {data.galleryImages && data.galleryImages.length > 0 && (
            <div class="animate-on-scroll">
              <h2 class="ji-heading-md mb-6">Gallery</h2>
              <div class="grid grid-cols-2 gap-4">
                {data.galleryImages.map((img, i) => (
                  <div class="rounded-xl overflow-hidden aspect-video bg-[rgb(var(--card-bg))] border border-[rgb(var(--border))]">
                    <img src={img} alt={`${data.title} screenshot ${i + 1}`} class="w-full h-full object-cover" loading="lazy" />
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
          <!-- Technologies -->
          <div class="ji-card animate-on-scroll">
            <h3 class="ji-heading-sm mb-4">Tech Stack</h3>
            <div class="flex flex-wrap gap-2">
              {data.technologies.map((tech) => (
                <span class="px-3 py-1.5 text-xs rounded-lg bg-[rgb(var(--background))] border border-[rgb(var(--border))] text-[rgb(var(--muted))] font-mono">
                  {tech}
                </span>
              ))}
            </div>
          </div>

          <!-- Project Info -->
          <div class="ji-card animate-on-scroll">
            <h3 class="ji-heading-sm mb-4">Project Info</h3>
            <dl class="space-y-3">
              <div>
                <dt class="text-xs text-[rgb(var(--muted))] ji-label mb-1">Category</dt>
                <dd>
                  <span class={`ji-badge ${getCategoryClass(data.category)}`}>
                    {category?.icon} {category?.label}
                  </span>
                </dd>
              </div>
              <div>
                <dt class="text-xs text-[rgb(var(--muted))] ji-label mb-1">Status</dt>
                <dd>
                  <span class={`ji-badge ${getStatusClass(data.status)} capitalize`}>
                    {data.status}
                  </span>
                </dd>
              </div>
              <div>
                <dt class="text-xs text-[rgb(var(--muted))] ji-label mb-1">Launched</dt>
                <dd class="text-sm text-[rgb(var(--foreground))]">{formatDate(data.createdDate)}</dd>
              </div>
            </dl>
          </div>

          <!-- Links -->
          <div class="ji-card animate-on-scroll space-y-2">
            <h3 class="ji-heading-sm mb-4">Links</h3>
            {data.liveUrl && (
              <a href={data.liveUrl} target="_blank" rel="noopener noreferrer"
                class="flex items-center gap-2 text-sm text-[rgb(var(--muted))] hover:text-indigo-400 transition-colors">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                </svg>
                Live Website
              </a>
            )}
            {data.githubUrl && (
              <a href={data.githubUrl} target="_blank" rel="noopener noreferrer"
                class="flex items-center gap-2 text-sm text-[rgb(var(--muted))] hover:text-indigo-400 transition-colors">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                </svg>
                GitHub Repository
              </a>
            )}
          </div>
        </div>
      </div>

      <!-- Related Projects -->
      {related.length > 0 && (
        <div class="mt-16 pt-16 border-t border-[rgb(var(--border))] animate-on-scroll">
          <h2 class="ji-heading-md mb-8">More {category?.label} Projects</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {related.map((p) => (
              <a href={`/projects/${p.data.slug}`} class="group ji-card-hover">
                <h3 class="ji-heading-sm mb-2 group-hover:text-indigo-400 transition-colors">{p.data.title}</h3>
                <p class="text-sm text-[rgb(var(--muted))] line-clamp-2">{p.data.description}</p>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>
</BaseLayout>
