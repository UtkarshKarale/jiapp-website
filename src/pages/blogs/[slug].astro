---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const blogs = await getCollection('blogs', ({ data }) => !data.draft);
  return blogs.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { data } = post;
const { Content } = await render(post);
---

<Layout title={`${data.title} | JiApps Blog`}>
  <main class="flex-grow flex flex-col items-center pt-24 pb-32 px-6 relative">
    <!-- Background pattern -->
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#8b8a891a_1px,transparent_1px),linear-gradient(to_bottom,#8b8a891a_1px,transparent_1px)] bg-[size:40px_40px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] -z-10"></div>
    
    <article class="max-w-4xl mx-auto w-full mt-12 bg-surface border border-border rounded-[2.5rem] shadow-sm overflow-hidden">
      
      {data.coverImage && (
        <div class="w-full h-[400px] overflow-hidden bg-brand-50 flex items-center justify-center">
          <img src={data.coverImage} alt={data.title} class="w-full h-full object-cover opacity-90 hover:opacity-100 transition-opacity duration-500" />
        </div>
      )}

      <div class="p-8 md:p-16 lg:px-24">
        <div class="mb-12 text-center">
          <span class="bg-brand-50 text-brand-700 text-xs font-bold px-3 py-1.5 rounded-full mb-6 inline-block uppercase tracking-wider">{data.category}</span>
          <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-extrabold text-ink tracking-tight mb-6 leading-tight">{data.title}</h1>
          
          <div class="flex items-center justify-center gap-4 text-ink-light font-medium mt-8 border-t border-border pt-8">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 bg-gradient-to-br from-brand-400 to-brand-600 rounded-full flex items-center justify-center text-white font-bold text-sm shadow-inner">
                {data.author ? data.author.charAt(0) : 'J'}
              </div>
              <div class="text-left">
                <p class="text-ink font-bold text-sm leading-tight">{data.author || 'JiApps Team'}</p>
                <p class="text-xs">{new Date(data.publishDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })} • {data.readingTime} min read</p>
              </div>
            </div>
          </div>
        </div>

        <div class="prose prose-lg md:prose-xl mx-auto
                    prose-headings:font-display prose-headings:font-bold prose-headings:text-ink prose-headings:tracking-tight
                    prose-p:text-ink-light prose-p:leading-relaxed
                    prose-a:text-brand-600 prose-a:font-semibold hover:prose-a:text-brand-500 prose-a:underline-offset-4
                    prose-blockquote:border-l-4 prose-blockquote:border-brand-500 prose-blockquote:bg-brand-50/50 prose-blockquote:pl-6 prose-blockquote:py-2 prose-blockquote:rounded-r-xl prose-blockquote:not-italic prose-blockquote:text-ink-light
                    prose-strong:text-ink prose-strong:font-bold
                    prose-ul:list-disc prose-ol:list-decimal prose-li:text-ink-light
                    prose-img:rounded-2xl prose-img:shadow-lg
                    prose-pre:bg-ink prose-pre:text-white prose-pre:rounded-2xl prose-pre:shadow-2xl prose-pre:p-6
                    max-w-none">
          <Content />
        </div>
      </div>
    </article>
  </main>
</Layout>
