---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { formatDate } from '../../lib/utils';

export async function getStaticPaths() {
  const blogs = await getCollection('blogs', ({ data }) => !data.draft);
  return blogs.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { data } = post;
const slug = post.id;
const { Content } = await render(post);

// Related posts
const allBlogs = await getCollection('blogs', ({ data }) => !data.draft);
const related = allBlogs
  .filter((p) => p.slug !== slug && p.data.tags.some((t) => data.tags.includes(t)))
  .slice(0, 3);
---

<BaseLayout
  title={data.title}
  description={data.description}
  image={data.coverImage}
  article={true}
  publishDate={data.publishDate}
>
  <!-- Reading progress bar -->
  <div id="reading-progress" style="width: 0%"></div>

  <div class="pt-24">
    <!-- Article Header -->
    <header class="ji-container py-12">
      <nav class="flex items-center gap-2 text-sm text-[rgb(var(--muted))] mb-8">
        <a href="/" class="hover:text-[rgb(var(--foreground))] transition-colors">Home</a>
        <span>/</span>
        <a href="/blogs" class="hover:text-[rgb(var(--foreground))] transition-colors">Blog</a>
        <span>/</span>
        <span class="text-[rgb(var(--foreground))] line-clamp-1">{data.title}</span>
      </nav>

      <div class="max-w-3xl animate-fade-up">
        <!-- Meta badges -->
        <div class="flex flex-wrap items-center gap-2 mb-4">
          <span class="ji-badge bg-indigo-500/10 text-indigo-400 border border-indigo-500/20">
            {data.category}
          </span>
          {data.featured && (
            <span class="ji-badge bg-amber-500/20 text-amber-400 border border-amber-500/30">
              ★ Featured
            </span>
          )}
          {data.readingTime && (
            <span class="text-sm text-[rgb(var(--muted))]">{data.readingTime} min read</span>
          )}
        </div>

        <h1 class="ji-heading-lg mb-4">{data.title}</h1>
        <p class="text-xl text-[rgb(var(--muted))] leading-relaxed mb-6">{data.description}</p>

        <!-- Author + Date -->
        <div class="flex items-center gap-4 pb-8 border-b border-[rgb(var(--border))]">
          <div class="w-10 h-10 rounded-full bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white font-bold">
            JI
          </div>
          <div>
            <div class="font-medium text-sm">{data.author}</div>
            <div class="text-sm text-[rgb(var(--muted))]">
              {formatDate(data.publishDate)}
              {data.updatedDate && data.updatedDate !== data.publishDate && (
                <span> · Updated {formatDate(data.updatedDate)}</span>
              )}
            </div>
          </div>

          <!-- Social Share -->
          <div class="ml-auto flex items-center gap-2">
            <span class="text-xs text-[rgb(var(--muted))] ji-label">Share:</span>
            <a
              href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(data.title)}&url=${encodeURIComponent(`https://jiapp.online/blogs/${slug}`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-8 h-8 rounded-lg border border-[rgb(var(--border))] flex items-center justify-center text-[rgb(var(--muted))] hover:text-sky-400 hover:border-sky-400/30 transition-all"
              aria-label="Share on Twitter"
            >
              <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </header>

    <!-- Cover Image -->
    {data.coverImage && (
      <div class="ji-container mb-12 animate-on-scroll">
        <div class="max-w-3xl overflow-hidden rounded-2xl border border-[rgb(var(--border))] aspect-video bg-gradient-to-br from-indigo-500/10 to-purple-500/10">
          <img
            src={data.coverImage}
            alt={data.title}
            class="w-full h-full object-cover"
            loading="eager"
          />
        </div>
      </div>
    )}

    <!-- Article Content -->
    <article class="ji-container pb-20">
      <div class="max-w-3xl">
        <div class="prose prose-lg dark:prose-invert max-w-none
          prose-headings:font-display prose-headings:tracking-tight
          prose-a:text-indigo-400 prose-a:no-underline hover:prose-a:underline
          prose-strong:text-[rgb(var(--foreground))]
          prose-code:text-indigo-400">
          <Content />
        </div>

        <!-- Tags -->
        {data.tags.length > 0 && (
          <div class="mt-12 pt-8 border-t border-[rgb(var(--border))]">
            <h3 class="ji-label text-[rgb(var(--muted))] mb-3">Tags</h3>
            <div class="flex flex-wrap gap-2">
              {data.tags.map((tag) => (
                <a href={`/tags/${tag}`}
                  class="px-3 py-1.5 text-sm rounded-full bg-[rgb(var(--card-bg))] border border-[rgb(var(--border))] text-[rgb(var(--muted))] hover:text-indigo-400 hover:border-indigo-500/30 transition-all">
                  #{tag}
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- Back to blog -->
        <div class="mt-8">
          <a href="/blogs" class="ji-btn-secondary">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
            </svg>
            Back to Blog
          </a>
        </div>
      </div>
    </article>

    <!-- Related Posts -->
    {related.length > 0 && (
      <div class="border-t border-[rgb(var(--border))]">
        <div class="ji-container py-16">
          <h2 class="ji-heading-md mb-8">Related Articles</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {related.map((p) => (
              <a href={`/blogs/${p.id}`} class="group ji-card-hover">
                <span class="text-xs text-indigo-400 ji-label mb-2 block">{p.data.category}</span>
                <h3 class="ji-heading-sm mb-2 group-hover:text-indigo-400 transition-colors line-clamp-2">{p.data.title}</h3>
                <p class="text-sm text-[rgb(var(--muted))] line-clamp-2">{p.data.description}</p>
                <div class="mt-3 text-xs text-[rgb(var(--muted))]">{formatDate(p.data.publishDate)}</div>
              </a>
            ))}
          </div>
        </div>
      </div>
    )}
  </div>
</BaseLayout>

<script>
  // Reading progress
  const progressBar = document.getElementById('reading-progress');
  if (progressBar) {
    window.addEventListener('scroll', () => {
      const scrollTop = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = (scrollTop / docHeight) * 100;
      progressBar.style.width = `${Math.min(progress, 100)}%`;
    });
  }
</script>
