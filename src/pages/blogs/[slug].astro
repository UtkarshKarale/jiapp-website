---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const blogs = await getCollection('blogs', ({ data }) => !data.draft);
  return blogs.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { data } = post;
const { Content } = await render(post);
---

<Layout title={`${data.title} | JiApps Blog`}>
  <main id="main" class="flex-grow px-4 sm:px-6 pt-10 md:pt-16">

    <article class="card !rounded-[2rem] max-w-4xl mx-auto w-full overflow-hidden">

      {data.coverImage && (
        <img src={data.coverImage} alt={data.title} class="w-full h-[260px] md:h-[400px] object-cover border-b-2 border-line" />
      )}

      <div class="p-6 sm:p-10 md:p-16">
        <header class="mb-12">
          <span class="chip !bg-lime mb-6">{data.category}</span>
          <h1 class="h-page mb-8">{data.title}</h1>

          <div class="flex items-center gap-3 pt-6 border-t-2 border-dashed border-line">
            <div class="w-11 h-11 bg-brand-500 text-white border-2 border-line rounded-full flex items-center justify-center font-extrabold font-display">
              {data.author ? data.author.charAt(0) : 'J'}
            </div>
            <div>
              <p class="font-bold leading-tight">{data.author || 'JiApps Team'}</p>
              <p class="text-xs text-ink-light">{new Date(data.publishDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })} • {data.readingTime} min read</p>
            </div>
          </div>
        </header>

        <div class="prose prose-lg md:prose-xl max-w-none
                    prose-headings:font-display prose-headings:font-extrabold prose-headings:text-ink prose-headings:tracking-tight
                    prose-p:text-ink-light prose-p:leading-relaxed
                    prose-a:text-brand-600 prose-a:font-bold prose-a:underline-offset-4 prose-a:decoration-2 hover:prose-a:bg-lime hover:prose-a:text-ink
                    prose-blockquote:border-l-4 prose-blockquote:border-line prose-blockquote:bg-sun/40 prose-blockquote:pl-6 prose-blockquote:py-2 prose-blockquote:rounded-r-xl prose-blockquote:not-italic prose-blockquote:text-ink
                    prose-strong:text-ink prose-strong:font-bold
                    prose-li:text-ink-light
                    prose-code:text-brand-700 prose-code:bg-brand-100 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:before:content-none prose-code:after:content-none
                    prose-img:rounded-2xl prose-img:border-2 prose-img:border-line
                    prose-pre:bg-ink prose-pre:text-white prose-pre:rounded-2xl prose-pre:border-2 prose-pre:border-line prose-pre:shadow-[6px_6px_0_var(--color-brand-500)] prose-pre:p-6">
          <Content />
        </div>
      </div>
    </article>

    <div class="max-w-4xl mx-auto mt-8">
      <a href="/blog" class="btn">Back to all posts</a>
    </div>
  </main>
</Layout>
