---
import Layout from '../layouts/Layout.astro';
import Marquee from '../components/ui/Marquee.astro';

const ticker = ['100% offline', 'Barcode scanners', 'Thermal printers', 'WhatsApp receipts', 'LAN sync', 'Zero database fees'];
const dl = 'https://github.com/UtkarshKarale/billz-release';
const dlIcon = 'M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4';
---

<Layout title="BillZ POS | JiApps">
  <main id="main" class="flex-grow">

    <section class="max-w-6xl mx-auto px-6 pt-14 md:pt-20 pb-16">
      <div class="sticker !bg-lime mb-8">
        <span class="w-2.5 h-2.5 rounded-full bg-brand-500 border-2 border-line"></span>
        Offline-first Point of Sale
      </div>

      <h1 class="h-mega max-w-4xl mb-7">Say goodbye to cloud subscriptions.</h1>

      <p class="text-lg md:text-xl text-ink-light max-w-2xl leading-relaxed mb-10">
        BillZ is a lightning-fast, native desktop POS built for Indian retailers. Run multiple counters over local Wi-Fi with zero database fees.
      </p>

      <div class="flex flex-col sm:flex-row gap-4">
        <a href={dl} target="_blank" rel="noopener" class="btn btn-violet">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d={dlIcon} /></svg>
          Download for Windows
        </a>
        <a href={dl} target="_blank" rel="noopener" class="btn">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d={dlIcon} /></svg>
          Download for Linux
        </a>
      </div>

      <!-- Real product screenshot in a window frame -->
      <figure class="mt-16 card !rounded-2xl overflow-hidden !shadow-[10px_10px_0_var(--color-brand-500)] border-line">
        <div class="flex items-center gap-2 px-4 py-3 bg-sun border-b-2 border-line">
          <span class="w-3 h-3 rounded-full bg-pop border-2 border-line"></span>
          <span class="w-3 h-3 rounded-full bg-lime border-2 border-line"></span>
          <span class="w-3 h-3 rounded-full bg-sky border-2 border-line"></span>
          <figcaption class="ml-3 text-xs font-bold">BillZ - Retail POS</figcaption>
        </div>
        <img src="/billz-dashboard.png" alt="BillZ dashboard showing today's sales, monthly revenue, stock and quick actions for new sale, add product and record purchase" class="w-full h-auto block" width="1316" height="736" loading="lazy" />
      </figure>
    </section>

    <Marquee items={ticker} />

    <!-- Features -->
    <section class="max-w-6xl mx-auto px-6 pt-24 grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="card p-8 !bg-lime">
        <div class="icon-tile mb-6">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" /></svg>
        </div>
        <h3 class="text-2xl font-extrabold mb-2">100% Offline Capable</h3>
        <p class="text-ink/80 leading-relaxed">Powered by a robust local SQLite database. Even if your internet connection goes down for days, your billing never stops.</p>
      </div>

      <div class="card p-8 !bg-brand-100">
        <div class="icon-tile mb-6">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
        </div>
        <h3 class="text-2xl font-extrabold mb-2">Native Hardware</h3>
        <p class="text-ink/80 leading-relaxed">Instantly connects with barcode scanners and thermal printers. No more clunky browser print dialogs slowing down your checkout lane.</p>
      </div>

      <div class="card p-8 !bg-pop/30">
        <div class="icon-tile mb-6">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>
        </div>
        <h3 class="text-2xl font-extrabold mb-2">WhatsApp Receipts</h3>
        <p class="text-ink/80 leading-relaxed">Send digital receipts directly to your customer's WhatsApp instantly. Save on paper and provide a modern retail experience.</p>
      </div>
    </section>
  </main>
</Layout>
