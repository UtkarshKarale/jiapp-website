---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allBlogs = await getCollection('blogs', ({ data }) => !data.draft);
const sortedBlogs = allBlogs.sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime());
---

<Layout title="Blog | JiApps">
  <main class="flex-grow flex flex-col items-center pt-24 pb-32 px-6 relative">
    
    <!-- Background pattern -->
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#8b8a891a_1px,transparent_1px),linear-gradient(to_bottom,#8b8a891a_1px,transparent_1px)] bg-[size:40px_40px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] -z-10"></div>
    
    <div class="max-w-5xl mx-auto text-center space-y-8 mt-12 w-full">
      <h1 class="font-display text-6xl md:text-7xl font-extrabold text-ink tracking-tight">
        Latest Updates
      </h1>
      <p class="text-xl md:text-2xl text-ink-light font-body max-w-2xl mx-auto">
        News, release notes, and insights on retail technology.
      </p>

      {sortedBlogs.length === 0 ? (
        <div class="border border-border bg-surface/50 border-dashed rounded-3xl p-16 text-ink-light mt-16 shadow-sm backdrop-blur-sm">
          <svg class="w-8 h-8 mx-auto mb-4 text-ink-lighter" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
          </svg>
          <p>No blog posts published yet. Check back soon!</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-16 text-left">
          {sortedBlogs.map((blog) => (
            <a href={`/blogs/${blog.id}`} class="group block border border-border bg-surface p-8 rounded-2xl hover:border-brand-300 hover:shadow-xl hover:shadow-brand-50/50 transition-all duration-300 relative overflow-hidden">
              <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-brand-300 to-brand-500 opacity-0 group-hover:opacity-100 transition-opacity"></div>
              
              <div class="flex items-center gap-3 mb-6">
                <span class="bg-brand-50 text-brand-700 text-xs font-bold px-3 py-1 rounded-full">{blog.data.category}</span>
                <span class="text-xs text-ink-lighter font-medium">{new Date(blog.data.publishDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
              </div>
              
              <h2 class="font-display text-2xl font-bold text-ink mb-3 group-hover:text-brand-600 transition-colors leading-tight">
                {blog.data.title}
              </h2>
              
              <p class="text-ink-light text-sm leading-relaxed mb-6 line-clamp-3">
                {blog.data.description}
              </p>
              
              <div class="flex items-center text-sm font-medium text-brand-600">
                Read Article
                <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </main>
</Layout>
