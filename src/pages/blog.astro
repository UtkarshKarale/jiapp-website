---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allBlogs = await getCollection('blogs', ({ data }) => !data.draft);
const sortedBlogs = allBlogs.sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime());
const tints = ['!bg-lime', '!bg-brand-100', '!bg-sky', '!bg-sun/60'];
---

<Layout title="Blog | JiApps">
  <main id="main" class="flex-grow">

    <section class="max-w-6xl mx-auto px-6 pt-14 md:pt-20">
      <h1 class="h-mega mb-7">Latest Updates</h1>
      <p class="text-lg md:text-xl text-ink-light max-w-2xl leading-relaxed">
        News, release notes, and insights on retail technology.
      </p>
    </section>

    <section class="max-w-6xl mx-auto px-6 mt-14">
      {sortedBlogs.length === 0 ? (
        <div class="border-2 border-dashed border-line rounded-3xl bg-white/60 p-16 text-center">
          <p class="font-display text-2xl font-extrabold mb-1">No posts yet</p>
          <p class="text-ink-light">Check back soon — release notes and retail tips land here first.</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {sortedBlogs.map((blog, i) => (
            <a href={`/blogs/${blog.id}`} class={`card lift group block p-8 ${tints[i % tints.length]}`}>
              <div class="flex items-center gap-3 mb-6">
                <span class="chip !bg-white">{blog.data.category}</span>
                <span class="text-xs font-bold text-ink/70">{new Date(blog.data.publishDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
              </div>
              <h2 class="text-2xl md:text-3xl font-extrabold mb-3 leading-tight">{blog.data.title}</h2>
              <p class="text-ink/80 leading-relaxed mb-6 line-clamp-3">{blog.data.description}</p>
              <span class="btn !py-2 !px-4 !text-sm !shadow-[3px_3px_0_var(--color-line)]">Read Article</span>
            </a>
          ))}
        </div>
      )}
    </section>
  </main>
</Layout>
