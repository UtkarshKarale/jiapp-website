---
import Layout from '../layouts/Layout.astro';

const solo = ['Single PC installation', 'Unlimited Products & Invoices', 'Basic thermal printing', 'Standard email support'];
const multi = ['Multi-PC LAN Sync', 'Apparel Size/Color Matrix', 'Instant WhatsApp Receipts', 'Priority WhatsApp Support'];

const faqs = [
  { q: 'How does the 7-day free trial work?', a: "You can sign up for either the Solo or Multi-Counter plan and get full access for 7 days without being charged. If you decide it's not for you, simply cancel before the trial ends." },
  { q: 'Do I need internet to use BillZ?', a: 'No. BillZ is entirely offline-first. You only need internet occasionally to verify your active subscription or if you choose to send digital receipts via WhatsApp.' },
  { q: 'How does the LAN sync work in the Multi-Counter plan?', a: "The primary PC acts as the local server. Secondary PCs connect to it over your local Wi-Fi router. You don't need an active internet connection, just a local network." },
];
const check = 'M5 13l4 4L19 7';
---

<Layout title="Pricing | JiApps">
  <main id="main" class="flex-grow">

    <section class="max-w-6xl mx-auto px-6 pt-14 md:pt-20">
      <div class="sticker !bg-sun mb-8">
        <span class="w-2.5 h-2.5 rounded-full bg-pop border-2 border-line"></span>
        7 Days Free Trial
      </div>
      <h1 class="h-mega max-w-4xl mb-7">BillZ POS Pricing</h1>
      <p class="text-lg md:text-xl text-ink-light max-w-2xl leading-relaxed">
        Affordable, transparent pricing tailored for Indian retailers. Try any plan free for 7 days.
      </p>
    </section>

    <!-- Launch offer -->
    <section class="max-w-6xl mx-auto px-6 mt-12">
      <div class="card !bg-lime -rotate-1 p-6 md:p-8 flex flex-col md:flex-row md:items-center justify-between gap-3">
        <div>
          <p class="text-xs font-extrabold tracking-wide mb-1">LIMITED TIME LAUNCH OFFER</p>
          <h2 class="text-3xl md:text-4xl font-extrabold">Buy 1 Month, Get 3 Months</h2>
        </div>
        <p class="font-medium max-w-sm md:text-right">Sign up today and your first month payment will cover you for 90 days.</p>
      </div>
    </section>

    <!-- Plans -->
    <section class="max-w-5xl mx-auto px-6 mt-16 grid grid-cols-1 md:grid-cols-2 gap-10 items-stretch">

      <div class="card p-8 md:p-10 flex flex-col">
        <h3 class="text-3xl font-extrabold mb-1">Solo</h3>
        <p class="text-ink-light mb-6">Perfect for single-counter retail shops.</p>
        <div class="mb-8">
          <span class="font-display text-6xl font-extrabold">₹99</span><span class="text-ink-light font-bold">/month</span>
          <p class="chip !bg-lime mt-3">Launch Offer: Pay ₹99 for 3 Months!</p>
        </div>
        <ul class="space-y-4 mb-10 flex-grow">
          {solo.map((f) => (
            <li class="flex items-center gap-3">
              <span class="w-6 h-6 rounded-full bg-lime border-2 border-line grid place-items-center shrink-0"><svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="4" d={check} /></svg></span>
              {f}
            </li>
          ))}
        </ul>
        <a href="https://accounts.jiapp.online" class="btn w-full">Start 7-Day Free Trial</a>
      </div>

      <div class="card p-8 md:p-10 flex flex-col relative !bg-brand-500 text-white md:-translate-y-4 !shadow-[8px_8px_0_var(--color-line)]">
        <span class="sticker !bg-sun text-ink absolute -top-4 right-6 rotate-3">Most Popular</span>
        <h3 class="text-3xl font-extrabold mb-1">Multi-Counter</h3>
        <p class="text-white/80 mb-6">For growing businesses with multiple billing lanes.</p>
        <div class="mb-8">
          <span class="font-display text-6xl font-extrabold">₹199</span><span class="text-white/80 font-bold">/month</span>
          <p class="chip !bg-lime text-ink mt-3">Launch Offer: Pay ₹199 for 3 Months!</p>
        </div>
        <ul class="space-y-4 mb-10 flex-grow">
          <li class="flex items-center gap-3 font-bold">
            <span class="w-6 h-6 rounded-full bg-lime text-ink border-2 border-line grid place-items-center shrink-0"><svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="4" d={check} /></svg></span>
            Everything in Solo
          </li>
          {multi.map((f) => (
            <li class="flex items-center gap-3">
              <span class="w-6 h-6 rounded-full bg-lime text-ink border-2 border-line grid place-items-center shrink-0"><svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="4" d={check} /></svg></span>
              {f}
            </li>
          ))}
        </ul>
        <a href="https://accounts.jiapp.online" class="btn btn-lime w-full">Start 7-Day Free Trial</a>
      </div>
    </section>

    <!-- FAQ -->
    <section class="max-w-3xl mx-auto px-6 mt-28">
      <h2 class="h-page text-center mb-10">Frequently Asked Questions</h2>
      <div class="space-y-5">
        {faqs.map((f, i) => (
          <details class="faq" open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </main>
</Layout>
