---
import Layout from '../layouts/Layout.astro';
---

<Layout title="JiApps | Specialized Tools for Business">
    <!-- Hero Section -->
    <main class="flex-grow flex flex-col items-center pt-24 pb-32 px-6 relative overflow-hidden">
      <!-- Background pattern -->
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#8b8a891a_1px,transparent_1px),linear-gradient(to_bottom,#8b8a891a_1px,transparent_1px)] bg-[size:40px_40px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] -z-10"></div>
      
      <div class="max-w-5xl mx-auto text-center mt-12 w-full">
        <!-- Badge -->
        <a href="/billz" class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-surface border border-border text-ink-light text-sm font-medium hover:bg-brand-50 hover:text-brand-600 transition-colors mb-8 shadow-sm">
          <span class="bg-brand-500 text-white text-[10px] font-bold px-2 py-0.5 rounded-full uppercase tracking-wider">New</span>
          Meet BillZ POS v1.0
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>

        <h1 class="font-display text-6xl md:text-8xl font-extrabold text-ink leading-[1.1] tracking-tight mb-8">
          Retail software, <br/>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-600 to-brand-400">supercharged.</span>
        </h1>
        
        <p class="text-xl md:text-2xl text-ink-light font-body max-w-2xl mx-auto leading-relaxed mb-10">
          The ultimate offline-first POS and unified account ecosystem for ambitious Indian retailers. Fast, reliable, and completely cloud-tax free.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/billz" class="w-full sm:w-auto bg-ink hover:bg-ink-light text-white font-medium px-8 py-4 rounded-xl transition-all shadow-xl hover:-translate-y-0.5 flex items-center justify-center gap-2">
            Get Started
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a href="https://accounts.jiapp.online" class="w-full sm:w-auto bg-surface border border-border hover:border-brand-300 text-ink font-medium px-8 py-4 rounded-xl transition-all hover:text-brand-600 shadow-sm flex items-center justify-center gap-2">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
            Sign In to Accounts
          </a>
        </div>
      </div>

      <!-- Products Grid -->
      <div id="products" class="max-w-5xl mx-auto w-full mt-32 grid grid-cols-1 md:grid-cols-2 gap-8 px-6">
        
        <!-- BillZ Card -->
        <a href="/billz" class="group block border border-border bg-surface p-10 rounded-2xl hover:border-brand-300 hover:shadow-xl hover:shadow-brand-50/50 transition-all duration-300 relative overflow-hidden">
          <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-brand-300 to-brand-500 opacity-0 group-hover:opacity-100 transition-opacity"></div>
          <div class="mb-6">
            <img src="/logo-billz.svg" alt="BillZ Logo" class="w-14 h-14 shadow-sm rounded-xl group-hover:scale-105 transition-transform" />
          </div>
          <h2 class="font-display text-2xl font-medium text-ink mb-3 group-hover:text-brand-600 transition-colors">BillZ POS</h2>
          <p class="text-ink-light leading-relaxed mb-8">
            Our flagship offline-first point of sale system. Built for speed with robust hardware support, clothing variants, and instant WhatsApp receipts. Zero cloud tax for multi-counter LAN setups.
          </p>
          <div class="flex items-center text-sm font-medium text-brand-600">
            Explore BillZ
            <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </div>
        </a>

        <!-- Accounts Card -->
        <a href="/accounts" class="group block border border-border bg-surface p-10 rounded-2xl hover:border-brand-300 hover:shadow-xl hover:shadow-brand-50/50 transition-all duration-300 relative overflow-hidden">
          <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-brand-300 to-brand-500 opacity-0 group-hover:opacity-100 transition-opacity"></div>
          <div class="mb-6">
            <img src="/logo-accounts.svg" alt="Accounts Logo" class="w-14 h-14 shadow-sm rounded-xl group-hover:scale-105 transition-transform" />
          </div>
          <h2 class="font-display text-2xl font-medium text-ink mb-3 group-hover:text-brand-600 transition-colors">JiApps Accounts</h2>
          <p class="text-ink-light leading-relaxed mb-8">
            The central hub for your business identity. Manage your subscriptions, sync devices, track onboarding, and securely authenticate across the JiApps ecosystem.
          </p>
          <div class="flex items-center text-sm font-medium text-brand-600">
            Sign in to Accounts
            <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </div>
        </a>

      </div>
    </main>
</Layout>
