---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Accounts | JiApps">
  <main id="main" class="flex-grow">

    <section class="max-w-6xl mx-auto px-6 pt-14 md:pt-20 pb-8">
      <div class="sticker !bg-brand-200 mb-8">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
        Unified Identity
      </div>

      <h1 class="h-mega max-w-4xl mb-7">One account for the entire ecosystem.</h1>

      <p class="text-lg md:text-xl text-ink-light max-w-2xl leading-relaxed mb-10">
        Manage your store profile, software licenses, subscriptions, and security from one centralized dashboard.
      </p>

      <a href="https://accounts.jiapp.online" class="btn btn-violet">
        Sign in to Dashboard
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
      </a>
    </section>

    <section class="max-w-6xl mx-auto px-6 pt-16 grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="card p-8 flex gap-6 items-start !bg-brand-100">
        <div class="icon-tile !w-14 !h-14 bg-lime">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
        </div>
        <div>
          <h3 class="text-2xl font-extrabold mb-2">Secure SSO</h3>
          <p class="text-ink/80 leading-relaxed">Authenticate once and access all your JiApps tools seamlessly. Uses industry-standard encryption and OAuth flows.</p>
        </div>
      </div>

      <div class="card p-8 flex gap-6 items-start !bg-sun/60">
        <div class="icon-tile !w-14 !h-14 bg-pop">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" /></svg>
        </div>
        <div>
          <h3 class="text-2xl font-extrabold mb-2">License Management</h3>
          <p class="text-ink/80 leading-relaxed">Easily view, revoke, or renew licenses for your offline desktop applications securely from the web.</p>
        </div>
      </div>
    </section>
  </main>
</Layout>
