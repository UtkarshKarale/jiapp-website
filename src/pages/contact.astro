---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact & Hire Us | JiApps Organization"
  description="Get in touch with JiApps. Inquire about custom IT services, web development, or product support for BillZ POS at hello@jiapp.online."
>
  <main id="main" class="flex-grow">

    <!-- Header Section -->
    <section class="max-w-6xl mx-auto px-6 pt-14 md:pt-20 pb-8">
      <div class="inline-flex items-center gap-2 sticker mb-6 rotate-0">
        <span class="w-2.5 h-2.5 rounded-full bg-brand-500"></span>
        <span>We Are Here to Help</span>
      </div>

      <h1 class="h-mega max-w-4xl mb-7">
        Get in touch with JiApp.
      </h1>

      <p class="text-lg md:text-2xl text-ink-light max-w-2xl leading-relaxed">
        Whether you are looking to hire our engineering team for custom development or need support for BillZ POS, we're ready to assist.
      </p>
    </section>

    <!-- Main Content Grid -->
    <section class="max-w-6xl mx-auto px-6 mt-8 pb-20 grid grid-cols-1 md:grid-cols-12 gap-8 items-start">

      <!-- Left Column: Contact Cards -->
      <div class="md:col-span-5 space-y-6">

        <!-- Primary Organization Email -->
        <div class="card p-8 !bg-brand-500 text-white">
          <div class="icon-tile mb-6 !bg-white/10 !border-white/20">
            <svg class="w-6 h-6 text-lime" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <span class="text-xs font-mono font-bold uppercase tracking-wider text-lime">Official Email</span>
          <h2 class="text-2xl font-extrabold mt-1 mb-2">Inquiries &amp; Hiring</h2>
          <p class="text-white/80 text-sm mb-4 leading-relaxed">
            For development projects, RFPs, custom software, enterprise sales, or partnerships.
          </p>
          <a
            href="mailto:hello@jiapp.online"
            class="font-mono font-bold text-lg text-lime underline decoration-2 underline-offset-4 hover:text-white transition-colors"
          >
            hello@jiapp.online
          </a>
          <p class="text-xs text-white/60 mt-3 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-lime animate-pulse"></span>
            Guaranteed response within 24 hours
          </p>
        </div>

        <!-- Live WhatsApp Support -->
        <div class="card p-8 !bg-lime">
          <div class="icon-tile mb-6">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z" />
            </svg>
          </div>
          <span class="text-xs font-mono font-bold uppercase tracking-wider text-ink/70">Instant Messaging</span>
          <h2 class="text-2xl font-extrabold mt-1 mb-2">WhatsApp Channel</h2>
          <p class="text-ink/80 text-sm mb-4 leading-relaxed">
            Need urgent onboarding assistance, hardware setup help, or a quick project conversation?
          </p>
          <a
            href="https://wa.me/919876543210?text=Hello%20JiApp%20Team,%20I%20have%20an%20inquiry."
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-ink text-sm w-full"
          >
            Message on WhatsApp &rarr;
          </a>
        </div>

        <!-- Fast Links Box -->
        <div class="card p-6 !bg-white space-y-3">
          <h3 class="font-extrabold text-base mb-2">Quick Navigation</h3>
          <div class="space-y-2 text-sm">
            <a href="/hire-us" class="flex items-center justify-between p-2.5 rounded-lg hover:bg-brand-50 font-bold transition-colors">
              <span>Start a Project Proposal</span>
              <span class="text-brand-500">&rarr;</span>
            </a>
            <a href="/services" class="flex items-center justify-between p-2.5 rounded-lg hover:bg-brand-50 font-bold transition-colors">
              <span>Explore Our IT Services</span>
              <span class="text-brand-500">&rarr;</span>
            </a>
            <a href="/billz" class="flex items-center justify-between p-2.5 rounded-lg hover:bg-brand-50 font-bold transition-colors">
              <span>BillZ POS Documentation</span>
              <span class="text-brand-500">&rarr;</span>
            </a>
          </div>
        </div>

      </div>

      <!-- Right Column: Interactive Contact Form -->
      <div class="md:col-span-7">
        <div class="card p-8 md:p-10 !bg-white">
          <h2 class="text-3xl font-extrabold mb-2">Send us a Message</h2>
          <p class="text-ink-light text-sm mb-8">
            Fill out this brief form and our team will get in touch with you right away.
          </p>

          <form id="contact-form" class="space-y-6">
            <!-- Inquiry Topic Selector -->
            <div>
              <label for="topic" class="block text-sm font-bold mb-2">Inquiry Type</label>
              <select id="topic" name="topic" class="field text-sm font-medium">
                <option value="services">Hire Us / Custom Development (Web, App, Software)</option>
                <option value="product">BillZ POS Demo &amp; Licensing</option>
                <option value="support">Technical Support &amp; Accounts Help</option>
                <option value="careers">Job Application / Careers</option>
                <option value="other">General Inquiries / Partnerships</option>
              </select>
            </div>

            <!-- Name and Email -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="contact-name" class="block text-sm font-bold mb-2">Your Name *</label>
                <input id="contact-name" name="name" type="text" required class="field" placeholder="Utkarsh Sharma" />
              </div>
              <div>
                <label for="contact-email" class="block text-sm font-bold mb-2">Email Address *</label>
                <input id="contact-email" name="email" type="email" required class="field" placeholder="you@company.com" />
              </div>
            </div>

            <!-- Subject / Company -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="contact-company" class="block text-sm font-bold mb-2">Company / Store Name</label>
                <input id="contact-company" name="company" type="text" class="field" placeholder="Company Name" />
              </div>
              <div>
                <label for="contact-phone" class="block text-sm font-bold mb-2">Phone / WhatsApp</label>
                <input id="contact-phone" name="phone" type="tel" class="field" placeholder="+91 98765 43210" />
              </div>
            </div>

            <!-- Message Field -->
            <div>
              <label for="contact-message" class="block text-sm font-bold mb-2">How can we help? *</label>
              <textarea
                id="contact-message"
                name="message"
                rows="5"
                required
                class="field text-sm"
                placeholder="Tell us about your requirements, project scope, questions, or timeline..."
              ></textarea>
            </div>

            <!-- Submit Button -->
            <div>
              <button
                type="submit"
                id="contact-submit-btn"
                class="btn btn-violet w-full !text-base !py-3.5"
              >
                Send Message &rarr;
              </button>

              <div id="contact-feedback" class="hidden mt-4 p-4 rounded-xl bg-lime/40 border-2 border-line text-sm font-bold text-ink">
                Thank you! Your message has been sent. We will respond from <strong class="underline">hello@jiapp.online</strong> within 24 hours.
              </div>
            </div>
          </form>
        </div>
      </div>

    </section>

  </main>

  <script>
    const contactForm = document.getElementById('contact-form') as HTMLFormElement | null;
    const contactFeedback = document.getElementById('contact-feedback');
    const contactBtn = document.getElementById('contact-submit-btn');

    contactForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (contactFeedback && contactBtn) {
        contactBtn.setAttribute('disabled', 'true');
        contactBtn.classList.add('opacity-50', 'cursor-not-allowed');
        contactFeedback.classList.remove('hidden');
        contactForm.reset();
      }
    });
  </script>
</Layout>
