---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_CONFIG } from '../lib/utils';

const contactReasons = [
  { icon: '🤝', label: 'Collaboration', desc: 'Work together on a product or project' },
  { icon: '💼', label: 'Freelance / Consulting', desc: 'Hire for a specific software project' },
  { icon: '🐛', label: 'Bug Report', desc: 'Report an issue with one of my products' },
  { icon: '💡', label: 'Feature Request', desc: 'Suggest an improvement or new feature' },
  { icon: '✍️', label: 'Guest Post', desc: 'Contribute an article to the blog' },
  { icon: '👋', label: 'Just saying hi', desc: 'Happy to connect with fellow builders' },
];
---

<BaseLayout title="Contact" description="Get in touch with JI — for collaborations, bug reports, feature requests, or just to say hello.">
  <div class="pt-28 pb-20">
    <div class="ji-container">
      <!-- Header -->
      <div class="max-w-2xl mb-16 animate-fade-up">
        <span class="ji-label text-[rgb(var(--muted))] mb-3 block">Let's talk</span>
        <h1 class="ji-heading-xl mb-4">
          Get in <span class="ji-gradient-text">Touch</span>
        </h1>
        <p class="text-xl text-[rgb(var(--muted))] leading-relaxed">
          Have a project idea, a question about one of my products, or just want to connect?
          I'd love to hear from you.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-5 gap-12">
        <!-- Form -->
        <div class="lg:col-span-3 animate-on-scroll">
          <form id="contact-form" class="space-y-5">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="name" class="ji-label text-[rgb(var(--muted))] block mb-2">Name</label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="Your name"
                  class="w-full px-4 py-3 rounded-xl bg-[rgb(var(--card-bg))] border border-[rgb(var(--border))] text-[rgb(var(--foreground))] placeholder:text-[rgb(var(--muted))] focus:outline-none focus:border-indigo-500/50 focus:ring-1 focus:ring-indigo-500/30 transition-all text-sm"
                />
              </div>
              <div>
                <label for="email" class="ji-label text-[rgb(var(--muted))] block mb-2">Email</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  placeholder="you@example.com"
                  class="w-full px-4 py-3 rounded-xl bg-[rgb(var(--card-bg))] border border-[rgb(var(--border))] text-[rgb(var(--foreground))] placeholder:text-[rgb(var(--muted))] focus:outline-none focus:border-indigo-500/50 focus:ring-1 focus:ring-indigo-500/30 transition-all text-sm"
                />
              </div>
            </div>

            <div>
              <label for="reason" class="ji-label text-[rgb(var(--muted))] block mb-2">Reason</label>
              <select
                id="reason"
                name="reason"
                class="w-full px-4 py-3 rounded-xl bg-[rgb(var(--card-bg))] border border-[rgb(var(--border))] text-[rgb(var(--foreground))] focus:outline-none focus:border-indigo-500/50 transition-all text-sm appearance-none cursor-pointer"
              >
                <option value="">Select a reason...</option>
                {contactReasons.map((r) => (
                  <option value={r.label}>{r.icon} {r.label}</option>
                ))}
              </select>
            </div>

            <div>
              <label for="subject" class="ji-label text-[rgb(var(--muted))] block mb-2">Subject</label>
              <input
                type="text"
                id="subject"
                name="subject"
                placeholder="What's this about?"
                class="w-full px-4 py-3 rounded-xl bg-[rgb(var(--card-bg))] border border-[rgb(var(--border))] text-[rgb(var(--foreground))] placeholder:text-[rgb(var(--muted))] focus:outline-none focus:border-indigo-500/50 focus:ring-1 focus:ring-indigo-500/30 transition-all text-sm"
              />
            </div>

            <div>
              <label for="message" class="ji-label text-[rgb(var(--muted))] block mb-2">Message</label>
              <textarea
                id="message"
                name="message"
                required
                rows="6"
                placeholder="Tell me what's on your mind..."
                class="w-full px-4 py-3 rounded-xl bg-[rgb(var(--card-bg))] border border-[rgb(var(--border))] text-[rgb(var(--foreground))] placeholder:text-[rgb(var(--muted))] focus:outline-none focus:border-indigo-500/50 focus:ring-1 focus:ring-indigo-500/30 transition-all text-sm resize-none"
              ></textarea>
            </div>

            <button type="submit" class="ji-btn-primary w-full justify-center py-4">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
              </svg>
              Send Message
            </button>

            <p id="form-status" class="text-sm text-center hidden"></p>
          </form>
        </div>

        <!-- Sidebar -->
        <div class="lg:col-span-2 space-y-6">
          <!-- Contact reasons -->
          <div class="ji-card animate-on-scroll">
            <h3 class="ji-heading-sm mb-5">Reasons to reach out</h3>
            <div class="space-y-3">
              {contactReasons.map((r) => (
                <div class="flex items-start gap-3">
                  <span class="text-xl">{r.icon}</span>
                  <div>
                    <div class="text-sm font-medium">{r.label}</div>
                    <div class="text-xs text-[rgb(var(--muted))]">{r.desc}</div>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Direct links -->
          <div class="ji-card animate-on-scroll">
            <h3 class="ji-heading-sm mb-4">Direct Contact</h3>
            <div class="space-y-3">
              <a href={`mailto:${SITE_CONFIG.email}`}
                class="flex items-center gap-3 text-sm text-[rgb(var(--muted))] hover:text-indigo-400 transition-colors">
                <div class="w-8 h-8 rounded-lg bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400 flex-shrink-0">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                {SITE_CONFIG.email}
              </a>
              <a href={SITE_CONFIG.linkedin} target="_blank" rel="noopener noreferrer"
                class="flex items-center gap-3 text-sm text-[rgb(var(--muted))] hover:text-indigo-400 transition-colors">
                <div class="w-8 h-8 rounded-lg bg-[rgb(var(--background))] border border-[rgb(var(--border))] flex items-center justify-center flex-shrink-0">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                  </svg>
                </div>
                LinkedIn
              </a>
            </div>
          </div>

          <!-- Response time -->
          <div class="ji-card animate-on-scroll">
            <div class="flex items-center gap-2 mb-2">
              <div class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></div>
              <span class="text-sm font-medium">Usually responds within 24–48h</span>
            </div>
            <p class="text-xs text-[rgb(var(--muted))]">Based in Pune, India (IST, UTC+5:30)</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const status = document.getElementById('form-status');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = 'Sending...';

    // Simulate form submission (replace with actual endpoint)
    await new Promise((resolve) => setTimeout(resolve, 1500));

    if (status) {
      status.classList.remove('hidden');
      status.classList.add('text-emerald-400');
      status.textContent = '✓ Message sent! I\'ll get back to you soon.';
    }
    form.reset();
    btn.disabled = false;
    btn.innerHTML = `<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" /></svg> Send Message`;
  });
</script>
