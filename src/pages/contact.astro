---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact | JiApps">
  <main class="flex-grow flex flex-col items-center pt-24 pb-32 px-6 relative">
    
    <!-- Background pattern -->
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#8b8a891a_1px,transparent_1px),linear-gradient(to_bottom,#8b8a891a_1px,transparent_1px)] bg-[size:40px_40px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] -z-10"></div>
    
    <div class="max-w-4xl mx-auto text-center space-y-8 mt-12 w-full">
      <h1 class="font-display text-6xl md:text-7xl font-extrabold text-ink tracking-tight">
        Get in touch
      </h1>
      <p class="text-xl md:text-2xl text-ink-light font-body max-w-2xl mx-auto mb-12">
        Whether you need enterprise support, custom integrations, or just want to say hi, we're here to help.
      </p>
    </div>

    <!-- Contact Grid -->
    <div class="max-w-5xl mx-auto w-full grid grid-cols-1 md:grid-cols-2 gap-8 mt-12">
      
      <!-- Contact Info -->
      <div class="space-y-8">
        <div class="border border-border bg-surface p-8 rounded-3xl shadow-sm">
          <div class="w-12 h-12 bg-brand-50 rounded-xl flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
          </div>
          <h3 class="font-display text-2xl font-bold text-ink mb-2">Email Us</h3>
          <p class="text-ink-light mb-4">Our friendly team is here to help.</p>
          <a href="mailto:support@jiapps.in" class="text-brand-600 font-medium hover:text-brand-700">support@jiapps.in</a>
        </div>

        <div class="border border-border bg-surface p-8 rounded-3xl shadow-sm">
          <div class="w-12 h-12 bg-brand-50 rounded-xl flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z" /></svg>
          </div>
          <h3 class="font-display text-2xl font-bold text-ink mb-2">Live Support</h3>
          <p class="text-ink-light mb-4">Available on WhatsApp for Pro users.</p>
          <a href="#" class="text-brand-600 font-medium hover:text-brand-700">Message on WhatsApp</a>
        </div>
      </div>

      <!-- Contact Form Placeholder -->
      <div class="border border-border bg-surface p-10 rounded-3xl shadow-sm">
        <h3 class="font-display text-2xl font-bold text-ink mb-6">Send a message</h3>
        <form class="space-y-6">
          <div>
            <label class="block text-sm font-medium text-ink mb-2">Full Name</label>
            <input type="text" class="w-full border border-border rounded-xl px-4 py-3 focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 transition-colors" placeholder="John Doe">
          </div>
          <div>
            <label class="block text-sm font-medium text-ink mb-2">Email Address</label>
            <input type="email" class="w-full border border-border rounded-xl px-4 py-3 focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 transition-colors" placeholder="john@company.com">
          </div>
          <div>
            <label class="block text-sm font-medium text-ink mb-2">Message</label>
            <textarea rows="4" class="w-full border border-border rounded-xl px-4 py-3 focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 transition-colors" placeholder="How can we help?"></textarea>
          </div>
          <button type="button" class="w-full bg-ink hover:bg-ink-light text-white font-medium py-4 rounded-xl transition-all shadow-md">
            Send Message
          </button>
        </form>
      </div>

    </div>
  </main>
</Layout>
