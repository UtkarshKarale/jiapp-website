---
interface Stat {
  value: string;
  label: string;
  icon: string;
}

const stats: Stat[] = [
  { value: '10+', label: 'Products Built', icon: '🚀' },
  { value: '5', label: 'Live Applications', icon: '⚡' },
  { value: '15K+', label: 'Active Users', icon: '👥' },
  { value: '3', label: 'Blog Articles', icon: '✍️' },
];
---

<section class="ji-section border-y border-[rgb(var(--border))]">
  <div class="ji-container">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-8">
      {stats.map((stat, i) => (
        <div class={`text-center animate-on-scroll`} style={`transition-delay: ${i * 100}ms`}>
          <div class="text-3xl mb-3">{stat.icon}</div>
          <div class="ji-heading-md ji-gradient-text mb-1">{stat.value}</div>
          <div class="text-sm text-[rgb(var(--muted))]">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>
