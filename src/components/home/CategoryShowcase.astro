---
import { CATEGORIES } from '../../lib/utils';

const categoryDetails = [
  {
    id: 'ji-apps',
    label: 'JI Apps',
    description: 'Custom SaaS products and software platforms built from the ground up',
    icon: '⚡',
    gradient: 'from-indigo-500/20 to-purple-500/20',
    borderColor: 'border-indigo-500/20',
    accentColor: 'text-indigo-400',
    count: '3 products',
  },
  {
    id: 'web',
    label: 'Web',
    description: 'Modern websites, landing pages, and web applications',
    icon: '🌐',
    gradient: 'from-cyan-500/20 to-blue-500/20',
    borderColor: 'border-cyan-500/20',
    accentColor: 'text-cyan-400',
    count: '2 projects',
  },
  {
    id: 'playstore',
    label: 'Play Store',
    description: 'Native and cross-platform Android applications',
    icon: '📱',
    gradient: 'from-emerald-500/20 to-teal-500/20',
    borderColor: 'border-emerald-500/20',
    accentColor: 'text-emerald-400',
    count: '1 app',
  },
  {
    id: 'exe',
    label: 'EXE',
    description: 'Desktop applications for Windows, macOS, and Linux',
    icon: '🖥️',
    gradient: 'from-orange-500/20 to-amber-500/20',
    borderColor: 'border-orange-500/20',
    accentColor: 'text-orange-400',
    count: '1 app',
  },
  {
    id: 'extensions',
    label: 'Extensions',
    description: 'Browser extensions and developer tools',
    icon: '🧩',
    gradient: 'from-purple-500/20 to-pink-500/20',
    borderColor: 'border-purple-500/20',
    accentColor: 'text-purple-400',
    count: 'Coming soon',
  },
  {
    id: 'blogs',
    label: 'Blogs',
    description: 'Technical articles, tutorials, and product stories',
    icon: '✍️',
    gradient: 'from-rose-500/20 to-pink-500/20',
    borderColor: 'border-rose-500/20',
    accentColor: 'text-rose-400',
    count: '3 posts',
    href: '/blogs',
  },
];
---

<section class="ji-section">
  <div class="ji-container">
    <!-- Section header -->
    <div class="mb-12 animate-on-scroll">
      <span class="ji-label text-[rgb(var(--muted))]">What we build</span>
      <h2 class="ji-heading-lg mt-2 mb-4">
        Explore by <span class="ji-gradient-text">Category</span>
      </h2>
      <p class="text-[rgb(var(--muted))] max-w-2xl">
        From SaaS platforms to mobile apps, every product is built with attention to craft, performance, and user experience.
      </p>
    </div>

    <!-- Category Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {categoryDetails.map((cat, i) => (
        <a
          href={cat.href || `/categories/${cat.id}`}
          class={`group ji-card-hover animate-on-scroll relative overflow-hidden`}
          style={`transition-delay: ${i * 80}ms`}
        >
          <!-- Gradient background -->
          <div class={`absolute inset-0 bg-gradient-to-br ${cat.gradient} opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-2xl`}></div>

          <div class="relative z-10">
            <!-- Icon -->
            <div class={`w-12 h-12 rounded-xl border ${cat.borderColor} bg-[rgb(var(--card-bg))] flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform duration-200`}>
              {cat.icon}
            </div>

            <!-- Content -->
            <div class="flex items-start justify-between mb-2">
              <h3 class={`ji-heading-sm group-hover:${cat.accentColor} transition-colors`}>
                {cat.label}
              </h3>
              <span class={`ji-label ${cat.accentColor} opacity-0 group-hover:opacity-100 transition-opacity`}>
                {cat.count}
              </span>
            </div>
            <p class="text-sm text-[rgb(var(--muted))] leading-relaxed">
              {cat.description}
            </p>

            <!-- Arrow -->
            <div class={`mt-4 flex items-center gap-1 ${cat.accentColor} text-sm font-medium opacity-0 group-hover:opacity-100 transition-all duration-200 translate-x-0 group-hover:translate-x-1`}>
              <span>Explore</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
