---
import { SITE_CONFIG, CATEGORIES } from '../../lib/utils';

const year = new Date().getFullYear();
---

<footer class="border-t border-[rgb(var(--border))] mt-auto">
  <div class="ji-container py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12">
      <!-- Brand -->
      <div class="md:col-span-1">
        <a href="/" class="flex items-center gap-2 mb-4">
          <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center">
            <span class="text-white text-xs font-bold" style="font-family: 'Syne', sans-serif;">JI</span>
          </div>
          <span class="font-bold text-lg" style="font-family: 'Syne', sans-serif;">JI App</span>
        </a>
        <p class="text-sm text-[rgb(var(--muted))] leading-relaxed mb-6">
          Building software, AI tools, and digital products from India.
        </p>
        <!-- Social Links -->
        <div class="flex items-center gap-3">
          {[
            {
              href: SITE_CONFIG.linkedin,
              label: 'LinkedIn',
              icon: `<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>`
            },
            {
              href: SITE_CONFIG.youtube,
              label: 'YouTube',
              icon: `<path d="M23.495 6.205a3.007 3.007 0 0 0-2.088-2.088c-1.87-.501-9.396-.501-9.396-.501s-7.507-.01-9.396.501A3.007 3.007 0 0 0 .527 6.205a31.247 31.247 0 0 0-.522 5.805 31.247 31.247 0 0 0 .522 5.783 3.007 3.007 0 0 0 2.088 2.088c1.868.502 9.396.502 9.396.502s7.506 0 9.396-.502a3.007 3.007 0 0 0 2.088-2.088 31.247 31.247 0 0 0 .5-5.783 31.247 31.247 0 0 0-.5-5.805zM9.609 15.601V8.408l6.264 3.602z"/>`
            },
          ].map(({ href, label, icon }) => (
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              class="w-9 h-9 rounded-lg border border-[rgb(var(--border))] bg-[rgb(var(--card-bg))] flex items-center justify-center text-[rgb(var(--muted))] hover:text-[rgb(var(--foreground))] hover:border-indigo-500/50 transition-all duration-200"
              aria-label={label}
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" set:html={icon} />
            </a>
          ))}
        </div>
      </div>

      <!-- Products -->
      <div>
        <h3 class="ji-label text-[rgb(var(--muted))] mb-4">Products</h3>
        <ul class="space-y-2">
          {CATEGORIES.map((cat) => (
            <li>
              <a
                href={`/categories/${cat.id}`}
                class="text-sm text-[rgb(var(--muted))] hover:text-[rgb(var(--foreground))] transition-colors flex items-center gap-2"
              >
                <span>{cat.icon}</span>
                <span>{cat.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Resources -->
      <div>
        <h3 class="ji-label text-[rgb(var(--muted))] mb-4">Resources</h3>
        <ul class="space-y-2">
          {[
            { href: '/blogs', label: 'Blog' },
            { href: '/rss.xml', label: 'RSS Feed' },
            { href: '/sitemap-index.xml', label: 'Sitemap' },
            { href: '/about', label: 'About' },
            { href: '/contact', label: 'Contact' },
          ].map(({ href, label }) => (
            <li>
              <a
                href={href}
                class="text-sm text-[rgb(var(--muted))] hover:text-[rgb(var(--foreground))] transition-colors"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Newsletter -->
      <div>
        <h3 class="ji-label text-[rgb(var(--muted))] mb-4">Stay Updated</h3>
        <p class="text-sm text-[rgb(var(--muted))] mb-4">
          Get notified when I ship new products or publish articles.
        </p>
        <form class="flex flex-col gap-2" onsubmit="return false;">
          <input
            type="email"
            placeholder="you@example.com"
            class="w-full px-3 py-2 rounded-lg bg-[rgb(var(--card-bg))] border border-[rgb(var(--border))] text-sm text-[rgb(var(--foreground))] placeholder:text-[rgb(var(--muted))] focus:outline-none focus:border-indigo-500/50 transition-colors"
          />
          <button
            type="submit"
            class="ji-btn-primary justify-center text-xs py-2"
          >
            Subscribe
          </button>
        </form>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-8 border-t border-[rgb(var(--border))] flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-[rgb(var(--muted))]">
        &copy; {year} JI. Built with{' '}
        <a href="https://astro.build" class="hover:text-indigo-400 transition-colors">Astro</a> &amp;{' '}
        <a href="https://tailwindcss.com" class="hover:text-indigo-400 transition-colors">Tailwind</a>
      </p>
      <div class="flex items-center gap-1">
        <div class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></div>
        <span class="text-xs text-[rgb(var(--muted))]">All systems operational</span>
      </div>
    </div>
  </div>
</footer>
