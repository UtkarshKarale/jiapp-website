---
import { formatDate } from '../../lib/utils';

interface Props {
  post: {
    id: string;
    data: {
      title: string;
      description: string;
      author: string;
      publishDate: string;
      tags: string[];
      category: string;
      coverImage?: string;
      featured: boolean;
      readingTime?: number;
    };
  };
  delay?: number;
}

const { post, delay = 0 } = Astro.props;
const { data } = post;
---

<a
  href={`/blogs/${post.id}`}
  class="group block ji-card-hover animate-on-scroll"
  style={`transition-delay: ${delay}ms`}
>
  <!-- Cover Image -->
  {data.coverImage && (
    <div class="relative overflow-hidden rounded-xl h-44 mb-5 bg-gradient-to-br from-indigo-500/10 to-purple-500/10">
      <img
        src={data.coverImage}
        alt={data.title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
        onerror="this.parentElement.style.display='flex'; this.parentElement.style.alignItems='center'; this.parentElement.style.justifyContent='center'; this.style.display='none'"
      />
      {data.featured && (
        <div class="absolute top-3 left-3">
          <span class="ji-badge bg-amber-500/20 text-amber-400 border border-amber-500/30 text-xs">
            ★ Featured
          </span>
        </div>
      )}
    </div>
  )}

  <!-- Meta -->
  <div class="flex items-center gap-3 mb-3">
    <span class="ji-badge bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 text-xs">
      {data.category}
    </span>
    {data.readingTime && (
      <span class="text-xs text-[rgb(var(--muted))]">{data.readingTime} min read</span>
    )}
  </div>

  <!-- Title -->
  <h3 class="ji-heading-sm mb-2 group-hover:text-indigo-400 transition-colors line-clamp-2">
    {data.title}
  </h3>

  <!-- Description -->
  <p class="text-sm text-[rgb(var(--muted))] leading-relaxed mb-4 line-clamp-3">
    {data.description}
  </p>

  <!-- Footer -->
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-2">
      <div class="w-7 h-7 rounded-full bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white text-xs font-bold">
        JI
      </div>
      <div>
        <div class="text-xs font-medium text-[rgb(var(--foreground))]">{data.author}</div>
        <div class="text-xs text-[rgb(var(--muted))]">{formatDate(data.publishDate)}</div>
      </div>
    </div>
    <svg class="w-4 h-4 text-[rgb(var(--muted))] group-hover:text-indigo-400 group-hover:translate-x-1 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
    </svg>
  </div>

  <!-- Tags -->
  {data.tags.length > 0 && (
    <div class="flex flex-wrap gap-1.5 mt-4 pt-4 border-t border-[rgb(var(--border))]">
      {data.tags.slice(0, 3).map((tag) => (
        <span class="text-xs text-[rgb(var(--muted))] bg-[rgb(var(--background))] border border-[rgb(var(--border))] px-2 py-0.5 rounded-full">
          #{tag}
        </span>
      ))}
    </div>
  )}
</a>
